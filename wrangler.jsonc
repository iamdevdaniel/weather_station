{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "weather-station-api",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-20",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "weather-station",
			"database_id": "43150165-bd35-4074-9fc4-97994dace8d1"
		}
	],
	"ratelimits": [
		{
			"name": "UPLOAD_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "PUBLIC_API_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	]
}
