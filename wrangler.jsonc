{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "weather-station-api",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-20",
	"assets": {
		"directory": ".local/worker-assets",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"vars": {
		"FIRMWARE_VERSION": "1.0.12",
		"FIRMWARE_SHA256": "6f31dc196dbf0beeaf783af5a40da4ffadf520444086cdec4bd451ab606eaea6"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "weather-station",
			"database_id": "43150165-bd35-4074-9fc4-97994dace8d1"
		}
	],
	"ratelimits": [
		{
			"name": "UPLOAD_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "PUBLIC_API_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	]
}
