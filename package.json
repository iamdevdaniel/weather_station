{
	"name": "weather-station",
	"private": true,
	"scripts": {
		"typecheck": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
		"lint": "biome check --files-ignore-unknown=true .",
		"lint:fix": "biome check --write --files-ignore-unknown=true .",
		"check": "npm run typecheck && npm run lint",
		"precommit": "lint-staged && npm run typecheck",
		"prepare": "husky",
		"firmware:build": "arduino-cli compile --fqbn esp8266:esp8266:nodemcuv2 --output-dir build .",
		"ui:dev": "vite",
		"ui:build": "vite build",
		"worker:deploy": "npm run ui:build && wrangler deploy",
		"db:migrate:production": "wrangler d1 migrations apply weather-station --remote"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@cloudflare/workers-types": "latest",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"dredd-style": "github:iamdevdaniel/dredd-style",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"typescript": "latest",
		"vite": "^8.3.5",
		"wrangler": "latest"
	},
	"dependencies": {
		"hono": "^4.13.13",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"recharts": "^3.10.1"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,jsonc}": [
			"biome check --write --no-errors-on-unmatched",
			"biome check --error-on-warnings --no-errors-on-unmatched"
		]
	}
}
